#compdef llmw
# zsh completion for llmw
# Install: 由 scripts/install.sh 自动 cp 到
#   ~/.local/share/zsh/site-functions/_llmw
# 并 prepend fpath 到 ~/.zshrc（带 marker 块幂等）。

# 收集 words[start..CURRENT-1] 中非 flag 的位置词（跳 --flag/--flag=val/-x）
# 用法: local -a pos=(${(f)"$(_llmw_pos_words 2)"})
_llmw_pos_words() {
    local -i i=$1
    while (( i < CURRENT )); do
        case ${words[$i]} in
            --*=*|-*) ;;
            *) print -r -- "${words[$i]}" ;;
        esac
        (( i++ ))
    done
}

_llmw() {
    # COMMON_OPTS 顶层定义，子处理器通过 zsh 动态作用域可见
    local -a COMMON_OPTS
    COMMON_OPTS=(
        '--workspace=[workspace 根路径]:path:_directories'
        '--json[输出 JSON 格式]'
        '--debug[打印 traceback]'
        '(--quiet -q)'{--quiet,-q}'[抑制 INFO]'
    )

    local -a TOP_CMDS
    TOP_CMDS=(
        'init:初始化 workspace'
        'config:workspace.toml 读写'
        'list:列出 wiki'
        'status:查看运行中的 wiki agent session'
        'check-fixtures:骨架探测器（检查 AGENTS.md / fixtures / legacy 一致性）'
        'upgrade:workspace 升级引擎'
        'model:workspace model registry'
        'wiki:wiki 子命令'
    )

    _llmw_workspace() {
        # 优先用 _LLMW_WS 缓存（dispatcher 处用未 shift 的 words 预计算，
        # 防止前置全局 --workspace= 在 shift 后丢失）
        if [[ -n "${_LLMW_WS:-}" ]]; then echo "$_LLMW_WS"; return; fi
        local ws=""
        local -i i=1
        while (( i < CURRENT )); do
            case ${words[$i]} in
                --workspace=*) ws="${words[$i]#--workspace=}";;
            esac
            (( i++ ))
        done
        if [[ -z "$ws" ]]; then
            ws="${LLMW_WORKSPACE:-$HOME/yzr-llm-wiki-workspace}"
        fi
        echo "$ws"
    }

    _llmw_wikis() {
        local ws="$(_llmw_workspace)"
        [[ -f "$ws/workspace.toml" ]] || return 0
        grep -oE '^\[wikis\.[a-z0-9_-]+\]' "$ws/workspace.toml" 2>/dev/null \
            | sed 's/^\[wikis\.//; s/\]$//'
    }

    _llmw_model_ids() {
        local ws="$(_llmw_workspace)"
        [[ -f "$ws/workspace_models.toml" ]] || return 0
        grep -oE '^model_id[[:space:]]*=[[:space:]]*"[^"]+"' "$ws/workspace_models.toml" 2>/dev/null \
            | sed -E 's/.*"([^"]+)".*/\1/'
    }

    # 用未 shift 的 words 预计算 workspace 路径（动态作用域 local，子函数可见）
    local _LLMW_WS="$(_llmw_workspace)"

    local state ret=1
    _arguments -C \
        '1: :->cmd' \
        '*:: :->args' \
        "${COMMON_OPTS[@]}" && ret=0

    case $state in
        cmd)
            _describe -t commands 'llmw command' TOP_CMDS && ret=0
            ;;
        args)
            # 找子命令索引 k（跳全局 flags，处理 `llmw --json wiki` 等场景）
            local -i k=2
            while (( k <= CURRENT )); do
                case ${words[$k]} in
                    --*=*|-*) (( k++ )); continue;;
                esac
                break
            done
            local ctx_line="${words[$k]:-}"
            # shift 到子命令位置：words[1]=subcommand（与 bash 对齐）
            words=("${(@)words[k,-1]}")
            (( CURRENT -= k - 1 ))
            case $ctx_line in
                init)
                    _arguments \
                        '--path=[workspace 路径]:path:_directories' \
                        '--display-name=[workspace 显示名]:display_name:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                list)
                    _arguments \
                        '--tag=[仅列出含此 tag (可重复, AND 关系)]:tag:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                status)
                    _arguments \
                        '--tmux[输出单行 ●N [✗M]（供状态条集成）]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                check-fixtures)
                    _arguments \
                        '--target-format=[目标 format 版本（缺省读 llmw.WORKSPACE_FORMAT_VERSION）]:target_format:' \
                        '--list-rules[列出所有 detector 规则（不跑检查）]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                upgrade)
                    _arguments \
                        '--apply[dry-run 模式变 apply 模式（写文件；TTY 默认 dry-run）]' \
                        '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                config)
                    _llmw_config && ret=0
                    ;;
                model)
                    _llmw_model && ret=0
                    ;;
                wiki)
                    _llmw_wiki && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_config() {
    local -a CFG_ACTS CFG_KEYS
    CFG_ACTS=(
        'get:取值'
        'set:设值'
        'unset:清值'
    )
    CFG_KEYS=(
        'enter_cli:agent CLI (claude|qodercli|opencode)'
        'templates_version:templates 版本(只读)'
        'created_at:创建时间(只读)'
        'schema_version:schema 版本(只读)'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->cfg_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            _describe -t actions 'config action' CFG_ACTS && ret=0
            ;;
        cfg_args)
            # 位置扫描：cfg_pos[1]=action；set 时再取 cfg_pos[2]=key
            local -a cfg_pos=(${(f)"$(_llmw_pos_words 2)"})
            local act="${cfg_pos[1]:-}"
            case $act in
                get|unset)
                    _describe -t keys 'config key' CFG_KEYS && ret=0
                    ;;
                set)
                    if [[ -z "${cfg_pos[2]:-}" ]]; then
                        local -a SET_KEYS=('enter_cli:agent CLI (claude|qodercli|opencode)')
                        _describe -t keys 'config key' SET_KEYS && ret=0
                    fi
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_model() {
    local -a MODEL_ACTS
    MODEL_ACTS=(
        'add:新增 model 条目'
        'list:列出所有 model 条目'
        'show:查看单条 model'
        'set-default:标记默认 model'
        'unset-default:清空默认标记'
        'remove:删除 model 条目'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->model_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            _describe -t actions 'model action' MODEL_ACTS && ret=0
            ;;
        model_args)
            local -a pos=(${(f)"$(_llmw_pos_words 2)"})
            local act="${pos[1]:-}"
            case $act in
                add)
                    _arguments \
                        '--model-id=[registry slug]:model_id:' \
                        '--name=[网关模型名]:name:' \
                        '--base-url=[API base URL]:base_url:_urls' \
                        '--api-key=[API key]:api_key:' \
                        '--default[标记为默认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                list|unset-default)
                    _arguments "${COMMON_OPTS[@]}" && ret=0
                    ;;
                show|set-default|remove)
                    local mid_seen=0
                    local -i i=3
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --model-id=*) mid_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( mid_seen )); then
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        local -a RM_OPTS
                        [[ "$act" == "remove" ]] && RM_OPTS=('(--yes -y)'{--yes,-y}'[跳过确认]')
                        _arguments \
                            '--model-id=[registry slug]:model_id:_llmw_model_ids' \
                            "${RM_OPTS[@]}" \
                            "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_wiki() {
    local -a WIKI_ACTS
    WIKI_ACTS=(
        'add:新建 wiki'
        'remove:移除 wiki'
        'rename:重命名 wiki (目录 + 索引 + metadata)'
        'show:查看 wiki 详情'
        'config:读写 wiki_metadata.toml'
        'enter:启动 AI agent session'
        'stop:终止 wiki 的 agent 窗口'
        'lint:wiki lint 检查'
        'check-fixtures:wiki 骨架探测器'
        'upgrade:wiki 升级引擎'
        'ingest-diff:列出未摄取 raw 文件'
        'write:wiki 内容写入编排'
        'external:raw/external 接入 / 重建编排'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->wiki_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            # 查 --name=/--path= 是否已见（跳 flag 扫描，flag 插在 wiki 与 action 之间也正确）
            local name_seen=0
            local path_seen=0
            local -i i=2
            while (( i < CURRENT )); do
                case ${words[$i]} in
                    --name=*) name_seen=1;;
                    --path=*) path_seen=1;;
                esac
                (( i++ ))
            done
            if (( name_seen || path_seen )); then
                _describe -t actions 'wiki action' WIKI_ACTS && ret=0
            else
                local -a WITH_WIKI_SELECT
                WITH_WIKI_SELECT=(
                    '--name=[目标 wiki 名]:name:_llmw_wikis'
                    '--path=[目标 wiki 根目录]:path:_directories'
                )
                _arguments "${WITH_WIKI_SELECT[@]}" '*:: :->wiki_args2' && ret=0
                case $state in
                    wiki_args2)
                        _describe -t actions 'wiki action' WIKI_ACTS && ret=0
                        ;;
                esac
            fi
            ;;
        wiki_args)
            # 位置扫描：pos[1] = wiki action（跳 wiki 本身）
            local -a pos=(${(f)"$(_llmw_pos_words 2)"})
            local act="${pos[1]:-}"
            case $act in
                add)
                    _arguments \
                        '--topic=[wiki 主题]:topic:' \
                        '--display-name=[显示名]:display_name:' \
                        '--description=[描述]:description:' \
                        '--tag=[tag (可重复)]:tag:' \
                        '--model=[绑定的 model_id]:model_id:_llmw_model_ids' \
                        '--git[opt-in: 初始化 git 仓]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                remove)
                    _arguments \
                        '--purge[同时删除 wiki 子目录]' \
                        '--no-backup[跳过 --purge 的备份步骤]' \
                        '(--yes -y)'{--yes,-y}'[跳过确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                rename)
                    _arguments \
                        '--old=[当前 wiki 名]:old:_llmw_wikis' \
                        '--new=[新 wiki 名 (须符合 NAME_RE)]:new:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                show)
                    _arguments "${COMMON_OPTS[@]}" && ret=0
                    ;;
                config)
                    local -a WIKI_CFG_KEYS=(
                        'display_name:显示名'
                        'description:描述'
                        'tags:tags (可重复)'
                        'model:绑定的 model_id'
                    )
                    # 位置扫描：wiki_pos 收集 config 子命令之后的位置词
                    # pos[1]="config" 由 wiki_args 外层消费；从位置 4 起拿 cfg_action
                    local -a wiki_pos=(${(f)"$(_llmw_pos_words 4)"})
                    local cfg_action="${wiki_pos[1]:-}"
                    local cfg_key="${wiki_pos[2]:-}"
                    if [[ -z "$cfg_action" ]]; then
                        local -a CFG_ACTS=(
                            'get:取值'
                            'set:设值'
                            'unset:清值'
                        )
                        _describe -t actions 'wiki config action' CFG_ACTS && ret=0
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    elif [[ -z "$cfg_key" ]]; then
                        _describe -t keys 'wiki config key' WIKI_CFG_KEYS && ret=0
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
                enter)
                    _arguments \
                        '--dry-run[仅打印 overlay 不启动 claude]' \
                        '--window-suffix=[并行窗口后缀（拼接为 <wiki>-<suffix>）]:suffix:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                stop)
                    _arguments \
                        '--window-suffix=[只匹配 <wiki>-<suffix> 窗口]:suffix:' \
                        '(--yes -y)'{--yes,-y}'[跳过确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                lint)
                    _arguments \
                        '--severity=[严重性过滤]:severity:(error warn info all)' \
                        '--no-git[跳过 raw/ 的 git status 检查]' \
                        '--check-version[扫 format 版本 + legacy 现场（互斥模式）]' \
                        '--apply[与 --check-version 联用：stdout JSON 输出 upgrade plan]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                check-fixtures)
                    _arguments \
                        '--target-format=[目标 format 版本]:target_format:' \
                        '--list-rules[列出 detector 规则]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                upgrade)
                    _arguments \
                        '--apply[落地（重渲染 byte-owned / 块替换 block-owned / 嫁接 header-owned）]' \
                        '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                ingest-diff)
                    _arguments \
                        '--relative[输出相对 wiki 根而非 raw/]' \
                        '--check-stale[额外检查 source 页 updated 早于 raw mtime]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                write)
                    local -a WIKI_WRITE_ACTS
                    WIKI_WRITE_ACTS=(
                        'log:追加 log 条目'
                        'index:操作 index 条目'
                        'touch:刷新 wiki 页面的 updated 字段'
                        'new:创建新 wiki 内容页'
                        'memory:创建/索引 MEMORY 条目'
                    )
                    local -a w_pos=(${(f)"$(_llmw_pos_words 4)"})
                    local wact="${w_pos[1]:-}"
                    if [[ -z "$wact" ]]; then
                        _describe -t actions 'wiki write action' WIKI_WRITE_ACTS && ret=0
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        case $wact in
                            log)
                                _arguments \
                                    '--op=[操作类型]:op:(ingest query lint setup)' \
                                    '--title=[标题]:title:' \
                                    '--bulk[批量模式]' \
                                    '--topic=[主题]:topic:' \
                                    '--count=[计数]:count:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            index)
                                if [[ -z "${w_pos[2]:-}" ]]; then
                                    local -a IDX_ACTS=('add:添加条目' 'remove:删除条目')
                                    _describe -t actions 'wiki write index action' IDX_ACTS && ret=0
                                    _arguments "${COMMON_OPTS[@]}" && ret=0
                                else
                                    _arguments "${COMMON_OPTS[@]}" && ret=0
                                fi
                                ;;
                            touch)
                                _arguments "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            new)
                                _arguments \
                                    '--type=[type]:type:(source comparison synthesis concept entity)' \
                                    '--slug=[页面 slug]:slug:' \
                                    '--title=[标题]:title:' \
                                    '--description=[描述]:description:' \
                                    '--tags=[tags 逗号分隔]:tags:' \
                                    '--sources=[sources (raw 路径，逗号分隔)]:sources:_files' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            memory)
                                _arguments \
                                    '--slug=[MEMORY 条目 slug]:slug:' \
                                    '--title=[短名（≤30 字）]:title:' \
                                    '--index-line=[索引行]:index_line:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                        esac
                    fi
                    ;;
                external)
                    local -a WIKI_EXTERNAL_ACTS
                    WIKI_EXTERNAL_ACTS=(
                        'add:接入外部仓（命名协商 + 登记 + 建 symlink）'
                        'remove:注销外部仓（删 entry + 删 symlink）'
                        'list:列出所有 entry + 状态'
                        'rebuild:跨主机重建（新机器跑一次）'
                    )
                    local -a e_pos=(${(f)"$(_llmw_pos_words 4)"})
                    local eact="${e_pos[1]:-}"
                    if [[ -z "$eact" ]]; then
                        _describe -t actions 'wiki external action' WIKI_EXTERNAL_ACTS && ret=0
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        case $eact in
                            add)
                                _arguments \
                                    '--name=[kebab-case symlink 名]:name:' \
                                    '--notes=[接入备注]:notes:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            remove|list)
                                _arguments "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            rebuild)
                                _arguments \
                                    '--target=[覆盖本地路径 NAME=PATH（可重复）]:target:' \
                                    '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                        esac
                    fi
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw "$@"
