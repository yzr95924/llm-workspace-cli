#compdef llmw
# zsh completion for llmw
# Install: 由 scripts/install.sh 自动 cp 到
#   ~/.local/share/zsh/site-functions/_llmw
# 并 prepend fpath 到 ~/.zshrc（带 marker 块幂等）。

_llmw() {
    local -a COMMON_OPTS
    COMMON_OPTS=(
        '--workspace=[workspace 根路径]:path:_directories'
        '--json[输出 JSON 格式]'
        '--debug[打印 traceback]'
        '(--quiet -q)'{--quiet,-q}'[抑制 INFO]'
    )

    local -a TOP_CMDS
    TOP_CMDS=(
        'init:初始化 workspace'
        'config:workspace.toml 读写'
        'list:列出 wiki'
        'status:查看运行中的 wiki agent session'
        'check-fixtures:骨架探测器（检查 AGENTS.md / fixtures / legacy 一致性）'
        'upgrade:workspace 升级引擎'
        'model:workspace model registry'
        'wiki:wiki 子命令'
    )

    _llmw_workspace() {
        local ws=""
        local -i i=1
        while (( i < CURRENT )); do
            local w=${words[$i]}
            case "$w" in
                --workspace=*) ws="${w#--workspace=}";;
            esac
            (( i++ ))
        done
        if [[ -z "$ws" ]]; then
            ws="${LLMW_WORKSPACE:-$HOME/yzr-llm-wiki-workspace}"
        fi
        echo "$ws"
    }

    _llmw_wikis() {
        local ws="$(_llmw_workspace)"
        [[ -f "$ws/workspace.toml" ]] || return 0
        grep -oE '^\[wikis\.[a-z0-9_-]+\]' "$ws/workspace.toml" 2>/dev/null \
            | sed 's/^\[wikis\.//; s/\]$//'
    }

    _llmw_model_ids() {
        local ws="$(_llmw_workspace)"
        [[ -f "$ws/workspace_models.toml" ]] || return 0
        grep -oE '^model_id[[:space:]]*=[[:space:]]*"[^"]+"' "$ws/workspace_models.toml" 2>/dev/null \
            | sed -E 's/.*"([^"]+)".*/\1/'
    }

    local state ret=1
    _arguments -C \
        '1: :->cmd' \
        '*:: :->args' \
        "${COMMON_OPTS[@]}" && ret=0

    case $state in
        cmd)
            _describe -t commands 'llmw command' TOP_CMDS
            ;;
        args)
            local ctx_line=${words[2]}
            case $ctx_line in
                init)
                    _arguments \
                        '--path=[workspace 路径]:path:_directories' \
                        '--display-name=[workspace 显示名]:display_name:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                list)
                    _arguments \
                        '--tag=[仅列出含此 tag (可重复, AND 关系)]:tag:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                status)
                    _arguments \
                        '--tmux[输出单行 ●N [✗M]（供状态条集成）]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                check-fixtures)
                    _arguments \
                        '--target-format=[目标 format 版本（缺省读 llmw.WORKSPACE_FORMAT_VERSION）]:target_format:' \
                        '--list-rules[列出所有 detector 规则（不跑检查）]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                upgrade)
                    _arguments \
                        '--apply[dry-run 模式变 apply 模式（写文件；TTY 默认 dry-run）]' \
                        '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                config)
                    _llmw_config && ret=0
                    ;;
                model)
                    _llmw_model && ret=0
                    ;;
                wiki)
                    _llmw_wiki && ret=0
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_config() {
    local -a COMMON_OPTS
    COMMON_OPTS=(
        '--workspace=[workspace 根路径]:path:_directories'
        '--json[输出 JSON 格式]'
        '--debug[打印 traceback]'
        '(--quiet -q)'{--quiet,-q}'[抑制 INFO]'
    )
    local -a CFG_ACTS CFG_KEYS
    CFG_ACTS=(
        'get:取值'
        'set:设值'
        'unset:清值'
    )
    CFG_KEYS=(
        'enter_cli:agent CLI (claude|qodercli|opencode)'
        'templates_version:templates 版本(只读)'
        'created_at:创建时间(只读)'
        'schema_version:schema 版本(只读)'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->cfg_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            _describe -t actions 'config action' CFG_ACTS
            ;;
        cfg_args)
            local act=${words[2]}
            case $act in
                get|unset)
                    _describe -t keys 'config key' CFG_KEYS
                    ;;
                set)
                    _arguments \
                        '1:key:->set_key' \
                        '2: : ' \
                        "${COMMON_OPTS[@]}" && ret=0
                    case $state in
                        set_key)
                            local -a SET_KEYS=('enter_cli:agent CLI (claude|qodercli|opencode)')
                            _describe -t keys 'config key' SET_KEYS
                            ;;
                    esac
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_model() {
    local -a COMMON_OPTS
    COMMON_OPTS=(
        '--workspace=[workspace 根路径]:path:_directories'
        '--json[输出 JSON 格式]'
        '--debug[打印 traceback]'
        '(--quiet -q)'{--quiet,-q}'[抑制 INFO]'
    )
    local -a MODEL_ACTS
    MODEL_ACTS=(
        'add:新增 model 条目'
        'list:列出所有 model 条目'
        'show:查看单条 model'
        'set-default:标记默认 model'
        'unset-default:清空默认标记'
        'remove:删除 model 条目'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->model_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            _describe -t actions 'model action' MODEL_ACTS
            ;;
        model_args)
            local act=${words[2]}
            case $act in
                add)
                    _arguments \
                        '--model-id=[registry slug]:model_id:' \
                        '--name=[网关模型名]:name:' \
                        '--base-url=[API base URL]:base_url:_urls' \
                        '--api-key=[API key]:api_key:' \
                        '--default[标记为默认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                list|unset-default)
                    _arguments "${COMMON_OPTS[@]}" && ret=0
                    ;;
                show|set-default|remove)
                    local mid_seen=0
                    local -i i=3
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --model-id=*) mid_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( mid_seen )); then
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        local -a RM_OPTS
                        [[ "$act" == "remove" ]] && RM_OPTS=('(--yes -y)'{--yes,-y}'[跳过确认]')
                        _arguments \
                            '--model-id=[registry slug]:model_id:_llmw_model_ids' \
                            "${RM_OPTS[@]}" \
                            "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw_wiki() {
    local -a COMMON_OPTS
    COMMON_OPTS=(
        '--workspace=[workspace 根路径]:path:_directories'
        '--json[输出 JSON 格式]'
        '--debug[打印 traceback]'
        '(--quiet -q)'{--quiet,-q}'[抑制 INFO]'
    )
    local -a WIKI_ACTS
    WIKI_ACTS=(
        'add:新建 wiki'
        'remove:移除 wiki'
        'rename:重命名 wiki (目录 + 索引 + metadata)'
        'show:查看 wiki 详情'
        'config:读写 wiki_metadata.toml'
        'enter:启动 AI agent session'
        'stop:终止 wiki 的 agent 窗口'
        'lint:wiki lint 检查'
        'check-fixtures:wiki 骨架探测器'
        'upgrade:wiki 升级引擎'
        'ingest-diff:列出未摄取 raw 文件'
        'write:wiki 内容写入编排'
        'external:raw/external 接入 / 重建编排'
    )
    local state ret=1
    _arguments -C \
        '1: :->action' \
        '*:: :->wiki_args' \
        "${COMMON_OPTS[@]}" && ret=0
    case $state in
        action)
            local name_seen=0
            local -i i=2
            while (( i < CURRENT )); do
                case ${words[$i]} in
                    --name=*) name_seen=1;;
                esac
                (( i++ ))
            done
            if (( name_seen )); then
                _describe -t actions 'wiki action' WIKI_ACTS
            else
                local -a WITH_NAME
                WITH_NAME=(
                    '--name=[目标 wiki 名]:name:_llmw_wikis'
                )
                _arguments "${WITH_NAME[@]}" '*:: :->wiki_args2' && ret=0
                case $state in
                    wiki_args2)
                        _describe -t actions 'wiki action' WIKI_ACTS
                        ;;
                esac
            fi
            ;;
        wiki_args)
            local act=${words[2]}
            case $act in
                add)
                    _arguments \
                        '--topic=[wiki 主题]:topic:' \
                        '--display-name=[显示名]:display_name:' \
                        '--description=[描述]:description:' \
                        '--tag=[tag (可重复)]:tag:' \
                        '--model=[绑定的 model_id]:model_id:_llmw_model_ids' \
                        '--git[opt-in: 初始化 git 仓]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                remove)
                    _arguments \
                        '--purge[同时删除 wiki 子目录]' \
                        '--no-backup[跳过 --purge 的备份步骤]' \
                        '(--yes -y)'{--yes,-y}'[跳过确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                rename)
                    # --old 从已注册 wiki 中补；--new free-form
                    _arguments \
                        '--old=[当前 wiki 名]:old:_llmw_wikis' \
                        '--new=[新 wiki 名 (须符合 NAME_RE)]:new:' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                show)
                    local name_seen=0
                    local -i i=2
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --name=*) name_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( name_seen )); then
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        _arguments \
                            '--name=[目标 wiki 名]:name:_llmw_wikis' \
                            "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
                config)
                    local -a WIKI_CFG_KEYS=(
                        'display_name:显示名'
                        'description:描述'
                        'tags:tags (可重复)'
                        'model:绑定的 model_id'
                    )
                    local name_seen=0
                    local -i i=2
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --name=*) name_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( ! name_seen )); then
                        _arguments \
                            '--name=[目标 wiki 名]:name:_llmw_wikis' \
                            "${COMMON_OPTS[@]}" && ret=0
                    else
                        # 收集位置参数到 wiki_pos：[0]=wiki [1]=config [2]=cfg_action [3]=cfg_key
                        local -a wiki_pos=()
                        local -i j=1
                        while (( j < CURRENT )); do
                            local w=${words[$j]}
                            case "$w" in
                                --*=*|-*) ;;
                                *) wiki_pos+=("$w") ;;
                            esac
                            (( j++ ))
                        done
                        local cfg_action="${wiki_pos[2]:-}"
                        local cfg_key="${wiki_pos[3]:-}"
                        if [[ -z "$cfg_action" ]]; then
                            local -a CFG_ACTS=(
                                'get:取值'
                                'set:设值'
                                'unset:清值'
                            )
                            _describe -t actions 'wiki config action' CFG_ACTS
                            _arguments "${COMMON_OPTS[@]}" && ret=0
                        elif [[ -z "$cfg_key" ]]; then
                            _describe -t keys 'wiki config key' WIKI_CFG_KEYS
                            _arguments "${COMMON_OPTS[@]}" && ret=0
                        else
                            # cfg_value 自由文本，不补
                            _arguments "${COMMON_OPTS[@]}" && ret=0
                        fi
                    fi
                    ;;
                enter)
                    local name_seen=0
                    local -i i=2
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --name=*) name_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( name_seen )); then
                        _arguments \
                            '--dry-run[仅打印 overlay 不启动 claude]' \
                            '--window-suffix=[并行窗口后缀（拼接为 <wiki>-<suffix>）]:suffix:' \
                            "${COMMON_OPTS[@]}" && ret=0
                    else
                        _arguments \
                            '--name=[目标 wiki 名]:name:_llmw_wikis' \
                            '--dry-run[仅打印 overlay 不启动 claude]' \
                            '--window-suffix=[并行窗口后缀（拼接为 <wiki>-<suffix>）]:suffix:' \
                            "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
                stop)
                    local name_seen=0
                    local -i i=2
                    while (( i < CURRENT )); do
                        case ${words[$i]} in
                            --name=*) name_seen=1;;
                        esac
                        (( i++ ))
                    done
                    if (( name_seen )); then
                        _arguments \
                            '--window-suffix=[只匹配 <wiki>-<suffix> 窗口]:suffix:' \
                            '(--yes -y)'{--yes,-y}'[跳过确认]' \
                            "${COMMON_OPTS[@]}" && ret=0
                    else
                        _arguments \
                            '--name=[目标 wiki 名]:name:_llmw_wikis' \
                            '--window-suffix=[只匹配 <wiki>-<suffix> 窗口]:suffix:' \
                            '(--yes -y)'{--yes,-y}'[跳过确认]' \
                            "${COMMON_OPTS[@]}" && ret=0
                    fi
                    ;;
                lint)
                    _arguments \
                        '--severity=[严重性过滤]:severity:(error warn info all)' \
                        '--no-git[跳过 raw/ 的 git status 检查]' \
                        '--check-version[扫 format 版本 + legacy 现场（互斥模式）]' \
                        '--apply[与 --check-version 联用：stdout JSON 输出 upgrade plan]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                check-fixtures)
                    _arguments \
                        '--target-format=[目标 format 版本]:target_format:' \
                        '--list-rules[列出 detector 规则]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                upgrade)
                    _arguments \
                        '--dry-run[仅打印计划，不写文件]' \
                        '--apply[落地（重渲染 byte-owned / 块替换 block-owned / 嫁接 header-owned）]' \
                        '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                ingest-diff)
                    _arguments \
                        '--relative[输出相对 wiki 根而非 raw/]' \
                        '--check-stale[额外检查 source 页 updated 早于 raw mtime]' \
                        "${COMMON_OPTS[@]}" && ret=0
                    ;;
                write)
                    local -a WIKI_WRITE_ACTS
                    WIKI_WRITE_ACTS=(
                        'log:追加 log 条目'
                        'index:操作 index 条目'
                        'touch:刷新 wiki 页面的 updated 字段'
                        'new:创建新 wiki 内容页'
                        'memory:创建/索引 MEMORY 条目'
                    )
                    if (( CURRENT == 3 )) || [[ -z "${words[3]:-}" ]]; then
                        _describe -t actions 'wiki write action' WIKI_WRITE_ACTS
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        local wact=${words[3]}
                        case $wact in
                            log)
                                _arguments \
                                    '--op=[操作类型]:op:(ingest query lint setup)' \
                                    '--title=[标题]:title:' \
                                    '--bulk[批量模式]' \
                                    '--topic=[主题]:topic:' \
                                    '--count=[计数]:count:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            index)
                                _arguments \
                                    '1:action:(add remove)' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            touch)
                                _arguments "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            new)
                                _arguments \
                                    '--type=[type]:type:(source comparison synthesis concept entity)' \
                                    '--slug=[页面 slug]:slug:' \
                                    '--title=[标题]:title:' \
                                    '--description=[描述]:description:' \
                                    '--tags=[tags 逗号分隔]:tags:' \
                                    '--sources=[sources (raw 路径，逗号分隔)]:sources:_files' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            memory)
                                _arguments \
                                    '--slug=[MEMORY 条目 slug]:slug:' \
                                    '--title=[短名（≤30 字）]:title:' \
                                    '--index-line=[索引行]:index_line:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                        esac
                    fi
                    ;;
                external)
                    local -a WIKI_EXTERNAL_ACTS
                    WIKI_EXTERNAL_ACTS=(
                        'add:接入外部仓（命名协商 + 登记 + 建 symlink）'
                        'remove:注销外部仓（删 entry + 删 symlink）'
                        'list:列出所有 entry + 状态'
                        'rebuild:跨主机重建（新机器跑一次）'
                    )
                    if (( CURRENT == 3 )) || [[ -z "${words[3]:-}" ]]; then
                        _describe -t actions 'wiki external action' WIKI_EXTERNAL_ACTS
                        _arguments "${COMMON_OPTS[@]}" && ret=0
                    else
                        local eact=${words[3]}
                        case $eact in
                            add)
                                _arguments \
                                    '--name=[kebab-case symlink 名]:name:' \
                                    '--notes=[接入备注]:notes:' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            remove)
                                _arguments "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            list)
                                _arguments "${COMMON_OPTS[@]}" && ret=0
                                ;;
                            rebuild)
                                _arguments \
                                    '--target=[覆盖本地路径 NAME=PATH（可重复）]:target:' \
                                    '(--yes -y)'{--yes,-y}'[跳过 TTY 二次确认]' \
                                    "${COMMON_OPTS[@]}" && ret=0
                                ;;
                        esac
                    fi
                    ;;
            esac
            ;;
    esac
    return ret
}

_llmw "$@"